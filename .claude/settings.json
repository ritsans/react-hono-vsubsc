{
  "permissions": {
    "deny": [
      "Read(.dev.vars*)",
      "Read(.env*)",
      "Grep(.dev.vars*)",
      "Grep(.env*)",
      "Bash(cat .dev.vars*)",
      "Bash(source .dev.vars*)",
      "Bash(. .dev.vars*)",
      "Bash(less .dev.vars*)",
      "Bash(more .dev.vars*)",
      "Bash(head .dev.vars*)",
      "Bash(tail .dev.vars*)",
      "Bash(cp .dev.vars*)",
      "Bash(cat .env*)",
      "Bash(source .env*)",
      "Bash(. .env*)",
      "Bash(less .env*)",
      "Bash(more .env*)",
      "Bash(head .env*)",
      "Bash(tail .env*)",
      "Bash(cp .env*)",
      "Bash(env)",
      "Bash(env *)",
      "Bash(printenv)",
      "Bash(printenv *)",
      "Bash(export DATABASE_URL*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_response.filePath // .tool_input.file_path // empty' | { read -r f; case \"$f\" in \"$CLAUDE_PROJECT_DIR\"/src/*) \"$CLAUDE_PROJECT_DIR/node_modules/.bin/biome\" format --write --files-ignore-unknown=true \"$f\";; esac; } 2>/dev/null || true",
            "timeout": 30,
            "statusMessage": "Biome format (src/ のみ)"
          }
        ]
      }
    ]
  }
}
